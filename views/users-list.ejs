<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="stylesheet" href="assets/css/sidebar-menu.css">
    <link rel="stylesheet" href="assets/css/simplebar.css">
    <link rel="stylesheet" href="assets/css/remixicon.css">
    <link rel="stylesheet" href="assets/css/style.css">

    <link rel="icon" type="image/png" href="assets/images/favicon.png">
    <title>Users List</title>
</head>
<body class="bg-body-bg">

<%- include('partials/header') -%>

<div class="container-fluid">
    <div class="main-content d-flex flex-column">

        <div class="main-content-container overflow-hidden">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
                <h3 class="mb-0">Users List</h3>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb align-items-center mb-0 lh-1">
                        <li class="breadcrumb-item">
                            <a href="/dashboard" class="d-flex align-items-center text-decoration-none">
                                <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                                <span class="text-body fs-14 hover">Dashboard</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <span>Admin</span>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <span class="text-secondary">Users List</span>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="card bg-white rounded-10 border border-white mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
                    <div class="d-flex flex-wrap gap-2 gap-xxl-5 align-items-center">
                        <form class="table-src-form position-relative m-0" onsubmit="return false;">
                            <input type="text" id="user-search" class="form-control w-340" placeholder="Search here...">
                            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                                <span class="material-symbols-outlined">search</span>
                            </div>
                        </form>
                        <ul class="p-0 mb-0 list-unstyled d-flex align-items-center flex-wrap" style="gap: 20px;">
                            <li class="fs-16">
                                All Users <span class="text-primary">(<%= users.length %>)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="default-table-area mx-minus-1 table-users-list">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th scope="col" class="fw-medium">User ID</th>
                                <th scope="col" class="fw-medium">Username</th>
                                <th scope="col" class="fw-medium">Email</th>
                                <th scope="col" class="fw-medium">Role</th>
                                <th scope="col" class="fw-medium">Date Joined</th>
                                <th scope="col" class="fw-medium">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-body py-4">No users found.</td>
                            </tr>
                            <% } %>
                            <% users.forEach(u => { %>
                            <tr data-searchable="<%= [u.username, u.email, u.role].filter(Boolean).join(' ').toLowerCase() %>">
                                <td class="text-body">#<%= u._id.toString().slice(-6) %></td>
                                <td class="text-body fw-medium"><%= u.username %></td>
                                <td class="text-body"><%= u.email %></td>
                                <td>
                                    <span class="badge <%= u.role === 'admin' ? 'bg-primary' : 'bg-secondary' %> text-capitalize">
                                        <%= u.role %>
                                    </span>
                                </td>
                                <td class="text-body"><%= u.createdAt ? u.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %></td>
                                <td>
                                    <div class="d-flex align-items-center" style="gap: 12px;">
                                        <% if (u._id.toString() !== currentUserId) { %>
                                        <form action="/change-role/<%= u._id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="bg-transparent p-0 border-0 hover-text-primary"
                                                data-bs-toggle="tooltip" data-bs-placement="top"
                                                data-bs-title="<%= u.role === 'admin' ? 'Demote to User' : 'Promote to Admin' %>">
                                                <i class="material-symbols-outlined fs-16 fw-normal text-body">
                                                    <%= u.role === 'admin' ? 'person_remove' : 'person_add' %>
                                                </i>
                                            </button>
                                        </form>
                                        <form action="/delete-user/<%= u._id %>" method="POST" style="display:inline;"
                                            onsubmit="return confirm('Delete user <%= u.username %>?');">
                                            <button type="submit" class="bg-transparent p-0 border-0 hover-text-danger"
                                                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Delete User">
                                                <i class="material-symbols-outlined fs-16 fw-normal text-body">delete</i>
                                            </button>
                                        </form>
                                        <% } else { %>
                                        <span class="text-muted fs-13">You</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                        <span class="fs-15" id="showing-count">Showing <%= users.length %> <%= users.length === 1 ? 'entry' : 'entries' %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-grow-1"></div>

        <%- include('partials/footer') -%>
    </div>
</div>

<script src="assets/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/sidebar-menu.js"></script>
<script src="assets/js/simplebar.min.js"></script>
<script src="assets/js/custom/custom.js"></script>
<script>
    document.getElementById('user-search').addEventListener('input', function () {
        const query = this.value.toLowerCase();
        const rows = document.querySelectorAll('.table-users-list tbody tr[data-searchable]');
        let visible = 0;
        rows.forEach(row => {
            const match = row.dataset.searchable.includes(query);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        const label = visible === 1 ? 'entry' : 'entries';
        document.getElementById('showing-count').textContent = `Showing ${visible} ${label}`;
    });
</script>
</body>
</html>
