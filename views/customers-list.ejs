<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="stylesheet" href="assets/css/sidebar-menu.css">
    <link rel="stylesheet" href="assets/css/simplebar.css">
    <link rel="stylesheet" href="assets/css/remixicon.css">
    <link rel="stylesheet" href="assets/css/style.css">

    <link rel="icon" type="image/png" href="assets/images/favicon.png">
    <title>Customers List</title>
</head>
<body class="bg-body-bg">

<%- include('partials/header') -%>

<div class="container-fluid">
    <div class="main-content d-flex flex-column">

        <div class="main-content-container overflow-hidden">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
                <h3 class="mb-0">Customers List</h3>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb align-items-center mb-0 lh-1">
                        <li class="breadcrumb-item">
                            <a href="/dashboard" class="d-flex align-items-center text-decoration-none">
                                <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                                <span class="text-body fs-14 hover">Dashboard</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <span class="text-secondary">Customers List</span>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="card bg-white rounded-10 border border-white mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
                    <% if (isUserAdmin(user)) { %>
                    <a href="/new-customer" class="btn btn-primary fw-normal text-white d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined fs-16">add</span>
                        Add New Customer
                    </a>
                    <% } %>
                    <div class="d-flex flex-wrap gap-2 gap-xxl-5 align-items-center">
                        <form class="table-src-form position-relative m-0" onsubmit="return false;">
                            <input type="text" id="customer-search" class="form-control w-340" placeholder="Search here...">
                            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                                <span class="material-symbols-outlined">search</span>
                            </div>
                        </form>
                        <ul class="p-0 mb-0 list-unstyled d-flex align-items-center flex-wrap" style="gap: 20px;">
                            <li class="fs-16">
                                All Customers <span class="text-primary">(<%= customers.length %>)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="default-table-area mx-minus-1 table-customers-list">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th scope="col" class="fw-medium">Customer ID</th>
                                <th scope="col" class="fw-medium">Name</th>
                                <th scope="col" class="fw-medium">Email</th>
                                <th scope="col" class="fw-medium">Phone</th>
                                <th scope="col" class="fw-medium">City</th>
                                <th scope="col" class="fw-medium">Country</th>
                                <th scope="col" class="fw-medium">Date Added</th>
                                <th scope="col" class="fw-medium">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% if (customers.length === 0) { %>
                            <tr>
                                <td colspan="8" class="text-center text-body py-4">No customers found.</td>
                            </tr>
                            <% } %>
                            <% customers.forEach(c => { %>
                            <tr data-searchable="<%= [c.name, c.email, c.phone, c.city, c.country].filter(Boolean).join(' ').toLowerCase() %>">
                                <td class="text-body">#<%= c._id.toString().slice(-6) %></td>
                                <td class="text-body fw-medium"><%= c.name %></td>
                                <td class="text-body"><%= c.email %></td>
                                <td class="text-body"><%= c.phone || '—' %></td>
                                <td class="text-body"><%= c.city || '—' %></td>
                                <td class="text-body"><%= c.country || '—' %></td>
                                <td class="text-body"><%= c.createdAt ? c.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %></td>
                                <td>
                                    <div class="d-flex align-items-center" style="gap: 12px;">
                                        <a href="/customer-details/<%= c._id %>"
                                            class="bg-transparent p-0 border-0 hover-text-primary d-flex"
                                            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="View Customer">
                                            <i class="material-symbols-outlined fs-16 fw-normal text-body">visibility</i>
                                        </a>
                                        <% if (isUserAdmin(user)) { %>
                                        <a href="/edit-customer/<%= c._id %>"
                                            class="bg-transparent p-0 border-0 hover-text-primary d-flex"
                                            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Edit Customer">
                                            <i class="material-symbols-outlined fs-16 fw-normal text-body">edit</i>
                                        </a>
                                        <form action="/delete-customer/<%= c._id %>" method="POST" style="display:inline;"
                                            onsubmit="return confirm('Delete customer <%= c.name %>?');">
                                            <button type="submit" class="bg-transparent p-0 border-0 hover-text-danger"
                                                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Delete Customer">
                                                <i class="material-symbols-outlined fs-16 fw-normal text-body">delete</i>
                                            </button>
                                        </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                        <span class="fs-15" id="showing-count">Showing <%= customers.length %> <%= customers.length === 1 ? 'entry' : 'entries' %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-grow-1"></div>

        <%- include('partials/footer') -%>
    </div>
</div>

<script src="assets/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/sidebar-menu.js"></script>
<script src="assets/js/simplebar.min.js"></script>
<script src="assets/js/custom/custom.js"></script>
<script>
    document.getElementById('customer-search').addEventListener('input', function () {
        const query = this.value.toLowerCase();
        const rows = document.querySelectorAll('.table-customers-list tbody tr[data-searchable]');
        let visible = 0;
        rows.forEach(row => {
            const match = row.dataset.searchable.includes(query);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        const label = visible === 1 ? 'entry' : 'entries';
        document.getElementById('showing-count').textContent = `Showing ${visible} ${label}`;
    });
</script>
</body>
</html>
