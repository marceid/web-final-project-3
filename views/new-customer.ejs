<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="stylesheet" href="assets/css/sidebar-menu.css">
    <link rel="stylesheet" href="assets/css/simplebar.css">
    <link rel="stylesheet" href="assets/css/remixicon.css">
    <link rel="stylesheet" href="assets/css/style.css">

    <link rel="icon" type="image/png" href="assets/images/favicon.png">
    <title>New Customer</title>
</head>
<body class="bg-body-bg">

<%- include('partials/header') -%>

<div class="container-fluid">
    <div class="main-content d-flex flex-column">

        <div class="main-content-container overflow-hidden">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
                <h3 class="mb-0">Create Customer</h3>

                <% if (message) { %>
                <div class="alert fs-16 alert-danger bg-danger text-white" role="alert">
                    <%= message %>
                </div>
                <% } %>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb align-items-center mb-0 lh-1">
                        <li class="breadcrumb-item">
                            <a href="/dashboard" class="d-flex align-items-center text-decoration-none">
                                <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                                <span class="text-body fs-14 hover">Dashboard</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/customers-list" class="text-decoration-none">
                                <span class="text-body fs-14 hover">Customers List</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <span class="text-secondary">Create Customer</span>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="card bg-white p-20 rounded-10 border border-white mb-4">
                <div class="row">
                    <div class="col-lg-8">
                        <h3 class="mb-20">Add a Customer</h3>
                        <form action="/new-customer" method="POST">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Full Name</label>
                                        <div class="form-floating">
                                            <input name="name" required type="text" class="form-control" id="floatingName" placeholder="Full Name">
                                            <label for="floatingName">Full Name</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Email</label>
                                        <div class="form-floating">
                                            <input name="email" required type="email" class="form-control" id="floatingEmail" placeholder="Email">
                                            <label for="floatingEmail">Email</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Phone</label>
                                        <div class="form-floating">
                                            <input name="phone" type="text" class="form-control" id="floatingPhone" placeholder="Phone">
                                            <label for="floatingPhone">Phone</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">City</label>
                                        <div class="form-floating">
                                            <input name="city" type="text" class="form-control" id="floatingCity" placeholder="City">
                                            <label for="floatingCity">City</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Country</label>
                                        <div class="form-floating">
                                            <input name="country" type="text" class="form-control" id="floatingCountry" placeholder="Country">
                                            <label for="floatingCountry">Country</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 mt-2">
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-primary fw-normal text-white">Create Customer</button>
                                        <a href="/customers-list" class="btn btn-outline-secondary fw-normal">Cancel</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-grow-1"></div>

        <%- include('partials/footer') -%>
    </div>
</div>

<script src="assets/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/sidebar-menu.js"></script>
<script src="assets/js/simplebar.min.js"></script>
<script src="assets/js/custom/custom.js"></script>
</body>
</html>
