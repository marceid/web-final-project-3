<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <base href="/">

    <link rel="stylesheet" href="/assets/css/sidebar-menu.css">
    <link rel="stylesheet" href="/assets/css/simplebar.css">
    <link rel="stylesheet" href="/assets/css/remixicon.css">
    <link rel="stylesheet" href="/assets/css/style.css">

    <link rel="icon" type="image/png" href="/assets/images/favicon.png">
    <title>Edit Order</title>
</head>
<body class="bg-body-bg">

<%- include('partials/header') -%>

<div class="container-fluid">
    <div class="main-content d-flex flex-column">

        <div class="main-content-container overflow-hidden">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
                <h3 class="mb-0">Edit Order</h3>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb align-items-center mb-0 lh-1">
                        <li class="breadcrumb-item">
                            <a href="/dashboard" class="d-flex align-items-center text-decoration-none">
                                <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                                <span class="text-body fs-14 hover">Dashboard</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/orders-list" class="text-decoration-none">
                                <span class="text-body fs-14 hover">Orders List</span>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <span class="text-secondary">Edit Order</span>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="card bg-white p-20 rounded-10 border border-white mb-4">
                <div class="row">
                    <div class="col-lg-9">
                        <h3 class="mb-20">Update Order</h3>
                        <form action="/edit-order/<%= order._id %>" method="POST">

                            <div class="row">
                                <!-- User -->
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">User</label>
                                        <select name="userId" class="form-select" required>
                                            <option value="">Select a user</option>
                                            <% users.forEach(u => { %>
                                            <option value="<%= u._id %>" <%= order.user && order.user.toString() === u._id.toString() ? 'selected' : '' %>>
                                                <%= u.username %> — <%= u.email %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <!-- Status -->
                                <div class="col-lg-6">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Status</label>
                                        <select name="status" class="form-select">
                                            <% ['pending','processing','shipped','delivered','cancelled'].forEach(s => { %>
                                            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>>
                                                <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <!-- Products -->
                                <div class="col-lg-12">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Products</label>

                                        <div id="product-rows">
                                            <% order.products.forEach(item => { %>
                                            <div class="product-row row g-2 mb-2 align-items-center">
                                                <div class="col-lg-8 col-md-7 col-9">
                                                    <select name="productIds[]" class="form-select" required>
                                                        <option value="">Select a product</option>
                                                        <% products.forEach(p => { %>
                                                        <option value="<%= p._id %>"
                                                            <%= item.product && item.product._id.toString() === p._id.toString() ? 'selected' : '' %>>
                                                            <%= p.title %> — $<%= p.price.toFixed(2) %>
                                                        </option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div class="col-lg-3 col-md-3 col-2">
                                                    <input type="number" name="quantities[]" class="form-control" value="<%= item.quantity %>" min="1" placeholder="Qty" required>
                                                </div>
                                                <div class="col-lg-1 col-md-2 col-1">
                                                    <button type="button" class="btn btn-outline-danger btn-sm btn-remove-row" title="Remove">
                                                        <span class="material-symbols-outlined fs-16" style="vertical-align: middle;">remove</span>
                                                    </button>
                                                </div>
                                            </div>
                                            <% }) %>
                                        </div>

                                        <button type="button" id="btn-add-product" class="btn btn-outline-primary btn-sm mt-1 d-flex align-items-center gap-1">
                                            <span class="material-symbols-outlined fs-16">add</span>
                                            Add Product
                                        </button>
                                    </div>
                                </div>

                                <!-- Notes -->
                                <div class="col-lg-12">
                                    <div class="mb-20">
                                        <label class="label fs-16 mb-2">Notes</label>
                                        <textarea name="notes" class="form-control" rows="3" placeholder="Optional notes..."><%= order.notes %></textarea>
                                    </div>
                                </div>

                                <div class="col-lg-12 mt-2">
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-primary fw-normal text-white">Update Order</button>
                                        <a href="/orders-list" class="btn btn-outline-secondary fw-normal">Cancel</a>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-grow-1"></div>

        <%- include('partials/footer') -%>
    </div>
</div>

<!-- Template row — kept outside the form so its required fields don't block submission -->
<div id="product-row-template" style="display:none;">
    <div class="product-row row g-2 mb-2 align-items-center">
        <div class="col-lg-8 col-md-7 col-9">
            <select name="productIds[]" class="form-select" required>
                <option value="">Select a product</option>
                <% products.forEach(p => { %>
                <option value="<%= p._id %>"><%= p.title %> — $<%= p.price.toFixed(2) %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-lg-3 col-md-3 col-2">
            <input type="number" name="quantities[]" class="form-control" value="1" min="1" placeholder="Qty" required>
        </div>
        <div class="col-lg-1 col-md-2 col-1">
            <button type="button" class="btn btn-outline-danger btn-sm btn-remove-row" title="Remove">
                <span class="material-symbols-outlined fs-16" style="vertical-align: middle;">remove</span>
            </button>
        </div>
    </div>
</div>

<script src="/assets/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/sidebar-menu.js"></script>
<script src="/assets/js/simplebar.min.js"></script>
<script src="/assets/js/custom/custom.js"></script>
<script>
    const template = document.getElementById('product-row-template').firstElementChild;

    document.getElementById('btn-add-product').addEventListener('click', function () {
        const clone = template.cloneNode(true);
        clone.querySelector('select').value = '';
        clone.querySelector('input[type="number"]').value = 1;
        document.getElementById('product-rows').appendChild(clone);
    });

    document.getElementById('product-rows').addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-remove-row');
        if (!btn) return;
        const rows = document.querySelectorAll('#product-rows .product-row');
        if (rows.length === 1) return;
        btn.closest('.product-row').remove();
    });
</script>
</body>
</html>
